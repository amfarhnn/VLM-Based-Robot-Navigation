        <mxCell id="9" value="Real robot approach where the Raspberry Pi handles robot-side camera, communication, and safety validation while the GPU computer performs model inference" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;strokeColor=#666666;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1">
